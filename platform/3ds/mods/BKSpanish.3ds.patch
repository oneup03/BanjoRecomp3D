 // Static pointers to our allocated glyph buffers (so they persist)
 static u8 *glyph_bufs[8];
 
+// Nintendo 3DS build (BanjoRecomp3D platform/3ds): the hook below runs again
+// whenever the game sets its fonts up, and allocated new buffers each time,
+// never freeing the old ones; the 3DS's recomp heap is small and shared with
+// the game's patches. Each glyph's buffer is allocated once (again only if
+// the glyph grows) and refilled.
+static s32 glyph_buf_sizes[8];
+static u8 *glyph_buffer(s32 i, s32 size) {
+    if (glyph_bufs[i] != NULL && glyph_buf_sizes[i] >= size) {
+        return glyph_bufs[i];
+    }
+    if (glyph_bufs[i] != NULL) {
+        recomp_free(glyph_bufs[i]);
+        glyph_bufs[i] = NULL;
+    }
+    u8 *buf = (u8 *)recomp_alloc((unsigned long)size);
+    glyph_buf_sizes[i] = (buf != NULL) ? size : 0;
+    return buf;
+}
